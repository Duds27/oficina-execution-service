{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Jwt": {
    "Issuer": "OficinaMecanicaBackend",
    "Audience": "OficinaMecanicaBackend"
  },
  "AllowedHosts": "*",
  "DynamoDb": {
    "TableName": "oficina-execucoes"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "oficina",
    "Username": "oficina"
  },
  "FaultInjection": {
    "RejeitarExecucao": false
  },
  "Outbox": {
    "IntervaloMs": 2000,
    "Lote": 25
  }
}
